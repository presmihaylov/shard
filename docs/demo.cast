[0.044871, "o", "# shard on a box with no /dev/kvm: pause, resume and fork on gVisor\r\n\r\n$ shard create --name web alpine:3.20 -- /bin/sh -c i=0; while true; do i=$((i+1)); echo tick $i; sleep 1; done\r\n"]
[0.583048, "o", "muddy-comet-92d3\r\n"]
[2.592939, "o", "\r\n$ shard exec web -- /bin/sh -c echo hello > /root/state\r\n"]
[2.656621, "o", "\r\n$ shard logs web\r\n"]
[2.662668, "o", "tick 1\r\ntick 2\r\ntick 3\r\n"]
[2.706456, "o", "  host RSS of sandbox web: 39796 KiB (pid 1532195)\r\n"]
[2.711512, "o", "\r\n$ shard pause web\r\n"]
[2.93549, "o", "muddy-comet-92d3\r\n"]
[2.945462, "o", "  -> 0.231 s\r\n"]
[2.945989, "o", "  the sandbox process is gone, its memory is back on the host:\r\n"]
[2.975886, "o", "  host RSS of pid 1532195: 39796 KiB before, gone after\r\n"]
[2.986714, "o", "  /sys/fs/cgroup/shard/muddy-comet-92d3/memory.current: gone\r\n"]
[2.988818, "o", "  host MemAvailable: +48292 KiB\r\n"]
[3.001899, "o", "\r\n$ ls -la /var/lib/shard-demo/snapshots/muddy-comet-92d3\r\n"]
[3.00401, "o", "total 1056\r\n"]
[3.004208, "o", "drwx------ 3 root root   4096 Aug 30 12:12 .\r\ndrwxr-x--- 3 root root   4096 Aug 30 12:12 ..\r\n-rw-r--r-- 1 root root 198312 Aug 30 12:12 checkpoint.img\r\n-rw-r--r-- 1 root root   4479 Aug 30 12:12 config.json\r\ndrwxr-x--- 5 root root   4096 Aug 30 12:12 layers\r\n-rw-r--r-- 1 root root 856064 Aug 30 12:12 pages.img\r\n-rw-r--r-- 1 root root   3512 Aug 30 12:12 pages_meta.img\r\n"]
[3.006962, "o", "\r\n$ shard resume web\r\n"]
[3.450639, "o", "muddy-comet-92d3\r\n"]
[3.459826, "o", "  -> 0.450 s\r\n"]
[5.464218, "o", "\r\n$ shard exec web -- cat /root/state\r\n"]
[5.543272, "o", "hello\r\n"]
[5.548122, "o", "  the loop went on from where the pause froze it:\r\n"]
[5.54817, "o", "\r\n$ shard logs web\r\n"]
[5.561577, "o", "tick 1\r\n"]
[5.562107, "o", "tick 2\r\ntick 3\r\ntick 4\r\ntick 5\r\n"]
[5.566937, "o", "\r\n"]
[5.569785, "o", "$ shard fork --name web-2 web\r\n"]
[6.062195, "o", "rough-firefly-28c3\r\n"]
[6.081864, "o", "  -> 0.514 s\r\n"]
[6.082249, "o", "\r\n$ shard ls\r\n"]
[6.089122, "o", "ID                   NAME    IMAGE                                 STATE     "]
[6.090027, "o", "UPTIME   IP\r\nmuddy-comet-92d3     web     index.docker.io/library/alpine:3.20   running   6s       10.87.0.2\r\nrough-firefly-28c3   web-2   index.docker.io/library/alpine:3.20   running   0s       10.87.0.3\r\n"]
[6.091219, "o", "\r\n$ shard exec web-2 -- cat /root/state\r\n"]
[6.157593, "o", "hello"]
[6.158683, "o", "\r\n"]
[6.163379, "o", "\r\n$ shard exec web-2 -- hostname\r\n"]
[6.2281, "o", "web-2\r\n"]
[6.231949, "o", "\r\n"]
[6.232027, "o", "# E2B quotes ~4 s/GiB to pause and ~1 s to resume, with a cloud round trip inside those numbers.\r\n"]
