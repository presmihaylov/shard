---
import type { IconName } from '../icons';
import Icon from '../Icon.astro';

interface Props {
	title: string;
	icon: IconName;
}

const { title, icon } = Astro.props;
---

<div data-slot="card" class="flex flex-col gap-3 rounded-md px-6 py-6">
	<span class="text-foreground"><Icon name={icon} size={22} /></span>
	<h3 class="text-base font-semibold leading-snug tracking-[-0.01em]">{title}</h3>
	<p class="text-sm leading-relaxed text-muted-foreground"><slot /></p>
</div>
