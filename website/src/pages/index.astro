---
import Card from '../components/landing/Card.astro';
import Landing from '../layouts/Landing.astro';
import { REPO_URL } from '../site';
---

<Landing title="shard" description="Placeholder description for the shard landing page.">
	<section class="mx-auto max-w-7xl px-6 pt-36 pb-20 md:px-8 md:pt-44">
		<span class="mono-label">Placeholder eyebrow</span>
		<h1 class="mt-6 max-w-3xl font-display text-5xl font-semibold leading-[1.1] tracking-[-0.025em] md:text-[4rem] md:leading-none">A placeholder headline for shard.</h1>
		<p class="typo-body-lg mt-6 max-w-xl text-muted-foreground">
			Placeholder copy for the hero. It holds the space for the real pitch, which lands with the content ticket.
		</p>
		<div class="mt-10 flex flex-wrap items-center gap-3">
			<a href="/docs/" class="vbtn vbtn--lg vbtn--neutral vbtn--primary nairi-focus-ring">
				<span>Read the docs</span>
			</a>
			<a href={REPO_URL} class="vbtn vbtn--lg vbtn--neutral vbtn--ghost border border-foreground/15 nairi-focus-ring">
				<span>View the source</span>
			</a>
		</div>
	</section>

	<section class="mx-auto max-w-7xl px-6 pb-28 md:px-8">
		<div class="grid gap-4 md:grid-cols-3">
			<Card title="Placeholder feature one" icon="code">Placeholder text for the first feature card.</Card>
			<Card title="Placeholder feature two" icon="book">Placeholder text for the second feature card.</Card>
			<Card title="Placeholder feature three" icon="checkCircle">Placeholder text for the third feature card.</Card>
		</div>
	</section>
</Landing>
